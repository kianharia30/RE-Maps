# ---------------------------------------------------------------------------
# RE-Maps environment configuration. Copy to `.env` and adjust.
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- database --------------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/remaps
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# --- API server ------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
RATE_LIMIT=120/minute

# --- geocoding -------------------------------------------------------------
# Nominatim is free and needs no key, but its usage policy REQUIRES an
# identifying User-Agent with contact details, and caps automated use at about
# one request per second. Both are enforced in app/geocode/nominatim.py.
# Put a real contact address in NOMINATIM_EMAIL before any sustained use.
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
GEOCODER_USER_AGENT=RE-Maps/0.1 (self-hosted property price map)
GEOCODER_MIN_INTERVAL_S=1.0
GEOCODE_CACHE_DAYS=30

# --- OPTIONAL: EPC property characteristics (UK) ---------------------------
# Free, but requires an account. Without these two variables the app still
# works; UK properties simply have no floor-area / habitable-room data and the
# UI shows those fields as unavailable. Nothing is ever invented in their place.
#   1. Register at https://epc.opendatacommunities.org/ (GOV.UK One Login)
#   2. Copy the email address you registered with and the API key you are given
EPC_API_BASE=https://epc.opendatacommunities.org/api/v1
EPC_API_EMAIL=
EPC_API_KEY=

# --- OPTIONAL: US county home values ---------------------------------------
# Free, instant, no payment. Without it the United States is not ingested at
# all; nothing is estimated in its place.
#   1. Request at https://api.census.gov/data/key_signup.html
#   2. Click the activation link in the email WITHIN 48 HOURS, or the key is
#      discarded and you must request another.
CENSUS_API_KEY=

# --- modelling -------------------------------------------------------------
AVM_MODEL_VERSION=cs-avm-1.2.0
FORECAST_MODEL_VERSION=shrunk-drift-1.2.0
FORECAST_MAX_HORIZON_YEARS=10

# --- data ------------------------------------------------------------------
DATA_DIR=./data

# --- frontend (Next.js; must be prefixed NEXT_PUBLIC_ to reach the browser) -
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
